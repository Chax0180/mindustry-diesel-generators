type: LaunchPad

name: Bulk Launch Pad
description: Launches batches of items to selected sectors. Only accepts one item type at a time. Can launch significantly more items than a regular launch pad.
details: Launches a large 2-stage pod with multiple standard pods stored inside.

scaledHealth: 45
size: 6
requirements:[
copper/1000
lead/800
plastanium/400
silicon/1000
metaglass/500
graphite/800
]

itemCapacity: 500
liquidCapacity: 80

consumes:{
power: 10.6666666
liquids: [
    kerosene/0.1333333
]
}
launchTime: 600
lightSteps: 4
drawLiquid: kerosene
category: effect
