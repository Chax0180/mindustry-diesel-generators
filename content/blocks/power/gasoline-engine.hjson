squareSprite: false
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      liquid: gasoline
      padding: 3
    }
    {
      type: DrawPistons
      suffix: -piston
      sinMag: 2
      sinScl: 6
    }
    {
      type: DrawDefault
    }
  ]
}
