type: ConsumeGenerator
name: Gasoline Engine
description: Generates power by combusting gasoline.
size: 2
category: power
research: fractional-distiller
  
requirements: [
lead/30
silicon/20
]
consumes: {
  liquid: gasoline/0.01666665
}
hasLiquids: true
liquidCapacity: 10
powerProduction: 6
  
ambientSound: loopMachineSpin
ambientSoundVolume: 0.18
squareSprite: false
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: gasoline
      padding: 3
    }
    {
      type: DrawPistons
      suffix: -piston
      sinMag: 1
      sinScl: 10
      sideOffset: 10
      lenOffset: -0.1
    }
    {
      type: DrawDefault
    }
  ]
}
